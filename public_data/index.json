              "editorial": {
                "pregame_story": {
                  "classification": "subjective_analysis",
                  "evidence_ids": [
                    "330404be65a58a95ff7f9113c73489f92550f1d61ef1e6eef4c3049ecd297c2d",
                    "479cc1aea8d92e389cd4b245a10da9d444a62a69d8b559dcae6101d336b00913",
