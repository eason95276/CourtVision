{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["sample_id","stage","dataset_revision","golden_set_revision","generation_revision","model_inputs","input_hash","prompt_hash","skill_hashes","parameters","tools","network_allowed","research_enabled","execution_ready","missing_prerequisites","output_path"],
