    "tools":{"type":"array","maxItems":0},"network_allowed":{"const":false},"research_enabled":{"const":false},"execution_ready":{"const":false},
    "missing_prerequisites":{"type":"array","items":{"type":"string"}},"output_path":{"type":"string"}
